{
	admin off
	auto_https off
	servers {
		# Only the reverse proxies named in HW_TRUSTED_PROXIES (.env) may state a visitor's address, so
		# a login lockout hits that visitor. Everyone else is known by the address they connect from.
		trusted_proxies static {$HW_TRUSTED_PROXIES:}
		trusted_proxies_strict
	}
}

:80 {
	redir https://{host}{uri} 308
}

:443 {
	tls /certs/cert.pem /certs/key.pem
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; frame-ancestors 'none'"
		-Server
	}
	request_body {
		max_size 8MB
	}
	reverse_proxy controller:8000 {
		header_up X-Forwarded-For {client_ip}
	}
}
