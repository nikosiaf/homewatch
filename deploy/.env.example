# homeWatch settings. install.sh fills these in; you can also edit them by hand.
# Keep this file private (chmod 600): HW_MASTER_KEY encrypts the tokens stored in the database.

# Release to run (see https://github.com/nikosiaf/homewatch/releases)
HW_VERSION=0.43.0

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Changing or losing it makes saved tokens unreadable (you would enter them again).
HW_MASTER_KEY=

# Time zone of this host, e.g. Europe/Athens
TZ=UTC

# Filled in by install.sh from this host's network, offered as defaults in the setup wizard
HW_GATEWAY_HINT=
HW_DNS_HINT=

# Ports on this host. Browsers use https://<host>:HW_HTTPS_PORT; the HTTP port only redirects there.
# Change them if they are taken (install.sh --https-port / --http-port sets them). 443 and 80 work too
# when nothing else on the host uses them; then the address is just https://<host>.
HW_HTTPS_PORT=5443
HW_HTTP_PORT=5080

# How long to keep metrics (VictoriaMetrics retention): 1y, 180d, 90d or 30d (System → History changes it)
HW_RETENTION=1y

# Optional parts of the stack. "grafana" adds Grafana at https://<homewatch>/grafana/ (System → Grafana
# turns it on or off; install.sh asks)
COMPOSE_PROFILES=

# Reverse proxies in front of homeWatch that may state the visitor's address (space-separated
# addresses or ranges, e.g. 192.168.1.1). Leave empty when browsers connect to homeWatch directly.
HW_TRUSTED_PROXIES=

# The private network between Caddy and the controller. Change it only if it clashes with yours.
#HW_EDGE_SUBNET=172.30.77.0/29
